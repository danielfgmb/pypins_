    "## 3. IC / BC and the three integrator residuals (the lf)\n",
    "\n",
    "Each residual receives `u` (current net), `u_prev` (frozen previous net, **graph kept** so we can take\n",
    "its $x$-derivatives), `x`, `dt`, and `nu`. The spatial operator $S(w) = w\\,w_x - \\nu\\,w_{xx}$ is computed\n",
    "by autograd; frozen-step terms are detached so no gradient reaches the previous network."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "ed6d31f3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "IC range: [1.006, 6.994]   BC value: 4.0000\n"
     ]
    }
   ],
   "source": [
    "x_ic_np = np.linspace(X0, XF, 201)\n",
    "u_ic_np = toothsaw(0, x_ic_np)\n",
    "x_ic = torch.tensor(x_ic_np, dtype=torch.float32).unsqueeze(1)\n",
    "u_ic = torch.tensor(u_ic_np, dtype=torch.float32).unsqueeze(1)\n",
    "\n",
    "u_bc_val = float(toothsaw(0, X0))\n",
    "x_bc = torch.tensor([[X0], [XF]], dtype=torch.float32)\n",
    "u_bc = torch.full((2, 1), u_bc_val, dtype=torch.float32)\n",
    "print(f'IC range: [{u_ic.min():.3f}, {u_ic.max():.3f}]   BC value: {u_bc_val:.4f}')\n",
    "\n",
    "x_dim = PINSpatialDimension('x', domain=(X0, XF), n_colloc=N_COLLOC)\n",
    "\n",
    "def make_residual(scheme):\n",
    "    \"\"\"Return a TD-PINN residual_fn implementing the chosen time integrator.\n",
    "\n",
    "    The integrator is encoded here (the loss function), NOT in the trainer.\n",
    "    \"\"\"\n",
    "    def residual(u, u_prev, x, dt, nu):\n",
    "        def S(w):                                   # spatial operator w*w_x - nu*w_xx\n",
    "            w_x  = torch.autograd.grad(w.sum(),   x, create_graph=True)[0]\n",
    "            w_xx = torch.autograd.grad(w_x.sum(), x, create_graph=True)[0]\n",
    "            return w * w_x - nu * w_xx\n",
    "        u_prev_val = u_prev.detach()\n",
    "        if scheme == 'EE':                          # Explicit Euler\n",
    "            return (u - u_prev_val) / dt + S(u_prev).detach()\n",
    "        if scheme == 'IE':                          # Implicit (Backward) Euler\n",
    "            return (u - u_prev_val) / dt + S(u)\n",
    "        if scheme == 'CN':                          # Crank-Nicolson\n",
    "            return (u - u_prev_val) / dt + 0.5 * (S(u) + S(u_prev).detach())\n",
    "        raise ValueError(scheme)\n",
    "    return residual\n",
    "\n",
    "INTEGRATORS = {\n",
    "    'Explicit Euler' : 'EE',\n",
    "    'Implicit Euler' : 'IE',\n",
    "    'Crank-Nicolson' : 'CN',\n",
    "}\n",
    "\n",
    "def exact_fn(t, x_pts):\n",
    "    u = toothsaw(t, x_pts.detach().cpu().numpy().ravel())\n",
    "    return torch.tensor(u, dtype=torch.float32, device=x_pts.device).unsqueeze(1)"
   ]
