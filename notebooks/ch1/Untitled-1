   "source": [
    "NU     = 0.07\n",
    "X0, XF = 0.0, 2 * np.pi\n",
    "\n",
    "def toothsaw(t, x):\n",
    "    \"\"\"Hopf-Cole analytic solution for viscous Burgers on [0, 2pi].\"\"\"\n",
    "    x  = np.asarray(x, dtype=float)\n",
    "    nu = NU\n",
    "    c  = 4 * nu * (t + 1)\n",
    "    a  = (-4*t + x)**2           / c\n",
    "    b  = (-4*t + x - 2*np.pi)**2 / c\n",
    "    num = ((-8*t + 2*x)            * np.exp(-a)\n",
    "         + (-8*t + 2*x - 4*np.pi) * np.exp(-b)) / c\n",
    "    den = np.exp(-b) + np.exp(-a)\n",
    "    return 2 * nu * num / den + 4\n",
    "\n",
    "x_plot = np.linspace(X0, XF, 500)\n",
    "fig, ax = plt.subplots(figsize=(8, 3.5))\n",
    "cmap = plt.cm.plasma\n",
    "for i, t in enumerate([0.0, 0.01, 0.02, 0.03]):\n",
    "    ax.plot(x_plot, toothsaw(t, x_plot), color=cmap(i / 3), lw=1.8, label=f't = {t:.3f}')\n",
    "ax.set_xlabel('x'); ax.set_ylabel('u')\n",
    "ax.set_title('Sawtooth analytic solution  (nu = 0.07)')\n",
    "ax.legend(loc='upper right'); ax.grid(alpha=0.3)\n",
    "plt.tight_layout(); plt.show()"
   ]
