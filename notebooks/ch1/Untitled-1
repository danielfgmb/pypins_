    "records = {}\n",
    "\n",
    "for name, code in INTEGRATORS.items():\n",
    "    torch.manual_seed(0); np.random.seed(0)\n",
    "    net = PINArchitecture(ARCH, PARAMS_ARCH)\n",
    "    loss_fn = PINLossFunction([x_dim], make_residual(code))\n",
    "    trainer = PINTrainer(\n",
    "        net=net, scheme='TD-PINNS', loss_fn=loss_fn, spatial_dims=[x_dim],\n",
    "        epochs=EPOCHS, dt=DT, lr=LR, tolerance=TOLERANCE,\n",
    "        ic_weight=IC_WEIGHT, bc_weight=BC_WEIGHT, pde_weight=PDE_WEIGHT,\n",
    "        collocation_fn=collocation_uniform, verbose=True, log_every=1000\n",
    "    )\n",
    "    t0 = time.perf_counter()\n",
    "    nets = trainer.fit(x_ic=x_ic, u_ic=u_ic, x_bc=x_bc, u_bc=u_bc, T=T_END, nu=NU)\n",
    "    wall = time.perf_counter() - t0\n",
    "\n",
    "    pde_steps    = trainer.step_history[1:]                      # skip the IC fit\n",
    "    final_losses = [h['final_loss'] for h in pde_steps]          # loss reached per step (fixed epochs)\n",
    "    df = compute_metrics(nets, times, [x_dim], n_eval=N_EVAL,\n",
    "                         exact_fn=exact_fn, device=trainer.device)\n",
    "\n",
    "    # compute_metrics gives L2 / Linf — add L1 (mean-abs) per level\n",
    "    xg = torch.linspace(X0, XF, N_EVAL).unsqueeze(1).to(trainer.device)\n",
    "    l1 = []\n",
    "    for t, net_t in zip(times, nets):\n",
    "        net_t.eval()\n",
    "        with torch.no_grad():\n",
    "            up = net_t(xg)\n",
    "            if up.dim() == 1:\n",
    "                up = up.unsqueeze(1)\n",
    "        l1.append(float((up - exact_fn(t, xg)).abs().mean()))\n",
    "    df['L1'] = l1\n",
    "\n",
    "    records[name] = {\n",
    "        'mean_loss'        : float(np.mean(final_losses)),       # <- new horizontal axis\n",
    "        'final_loss_series': final_losses,\n",
    "        'mean_L1'          : float(df['L1'].mean()),\n",
    "        'mean_L2'          : float(df['L2'].mean()),\n",
    "        'mean_Linf'        : float(df['Linf'].mean()),\n",
    "        'final_Linf'       : float(df['Linf'].iloc[-1]),\n",
    "        'wall_s'           : wall,\n",
    "        'linf_series'      : df['Linf'],\n",
    "        'nets'             : nets,\n",
    "        'device'           : trainer.device,\n",
    "    }\n",
    "    print(f'{name:16s} | mean loss {np.mean(final_losses):.4e} '\n",
    "          f'| mean Linf {df[\"Linf\"].mean():.4e} | wall {wall:5.1f}s')"
